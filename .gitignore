# Dependencies and local package-manager caches
node_modules/
.npm/
.pnpm-store/

# Vite / TypeScript build output and caches
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
.cache/

# Vitest / coverage and Playwright-generated reports
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files (track examples/templates, not credentials)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Editor / operating-system state
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini

# Keep npm's package-lock.json, source code, and test fixtures tracked.
.superpowers/
